# -- Green Optima CMS — Environment Variables ------------------------------
# Fill in your values before running the server.

# Admin panel password (minimum 8 characters, required)
ADMIN_PASSWORD=StrongPass123!

# Secret key for signing session cookies — change this to a long random string!
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Server port (optional, defaults to 3000)
PORT=3000

# Set to 'production' on live server (enables secure cookies)
NODE_ENV=development
